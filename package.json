{
  "name": "helpdesk-api-back",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST para gestão de chamados e suporte técnico",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:local": "node scripts/local-db.js start",
    "db:local:stop": "node scripts/local-db.js stop",
    "setup:technician": "node scripts/setup-technician.js",
    "setup:local": "node scripts/setup-local.js",
    "setup:e2e": "node scripts/setup-e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "supertest": "^7.1.1"
  }
}
